! Experiment flags (part of A/B testing)
! * Remove "or ask a question" from search bar placeholder
www.youtube.com#%#//scriptlet('ubo-set', 'ytcfg.data_.EXPERIMENT_FLAGS.enable_ai_searchbox_ux', 'false')
! * Autocomplete search suggestions
www.youtube.com#%#//scriptlet('ubo-set', 'ytcfg.data_.EXPERIMENT_FLAGS.enable_ai_mode_suggest_client', 'false')
! * Ask YouTube button
www.youtube.com#%#//scriptlet('ubo-set', 'ytcfg.data_.EXPERIMENT_FLAGS.enable_ai_mode_searchbox_entrypoint', 'false')
! * Don't shift searchbox upwards when focused
www.youtube.com#%#//scriptlet('ubo-set', 'ytcfg.data_.EXPERIMENT_FLAGS.enable_ai_searchbox_client_changes', 'false')
! * Don't darken background when search bar is focused
www.youtube.com#%#//scriptlet('ubo-set', 'ytcfg.data_.EXPERIMENT_FLAGS.enable_ai_search_ui', 'false')
www.youtube.com#%#//scriptlet('ubo-set', 'ytcfg.data_.EXPERIMENT_FLAGS.enable_ai_search_web_m0_fixes', 'false')
