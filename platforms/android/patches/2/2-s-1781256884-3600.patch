! https://github.com/AdguardTeam/AdguardFilters/issues/233166
! Website creates iframe with blank source so AdGuard app does not inject content script into it
! This rule overrides the src property of HTMLScriptElement in the iframe and replace it using property from the top window which is overridden by AdGuard
! Required to fix video player
!+ PLATFORM(windows, mac, android, cli)
footballtransfers.com#%#(()=>{const e={apply:(e,t,r)=>{try{const o=Reflect.apply(e,t,r),p=r[0];if(o?.matches?.("ins")&&p?.querySelector?.("iframe")){const e=p.querySelector("iframe"),t=Object.getOwnPropertyDescriptor(HTMLScriptElement.prototype,"src");Object.defineProperty(e.contentWindow.HTMLScriptElement.prototype,"src",{set:t.set,get:t.get})}return o}catch(e){}return Reflect.apply(e,t,r)}};window.Node.prototype.replaceChild=new Proxy(window.Node.prototype.replaceChild,e)})();
