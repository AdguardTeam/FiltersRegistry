{
  "name": "adguard-filters",
  "version": "1.1.0",
  "description": "AdGuard filters registry",
  "homepage": "https://adguard.com",
  "main": "scripts/build.js",
  "scripts": {
    "lint": "eslint . --cache --ext .js",
    "build": "node scripts/build.js",
    "build:patches": "bash scripts/patches.sh",
    "save_platforms": "bash scripts/save_old_platforms.sh",
    "publish": "bash scripts/push_platforms.sh",
    "validate": "yarn validate:platforms && validate:locales",
    "validate:platforms": "node scripts/validate-platforms.js",
    "validate:locales": "node scripts/validate-locales.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "adguard-filters-compiler": "git+https://github.com/AdguardTeam/FiltersCompiler.git#v1.1.115",
    "@adguard/diff-builder": "git+https://github.com/AdguardTeam/DiffBuilder.git#test-dist"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0"
  }
}
